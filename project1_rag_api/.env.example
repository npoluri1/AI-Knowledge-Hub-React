# Project 1: Simple RAG API — Environment Variables
# Copy this file to .env and fill in your values

# App
DEBUG=false
HOST=0.0.0.0
PORT=8000

# LLM Provider: openai | anthropic | google | ollama
LLM_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Provider: sentence-transformers | openai | voyage | cohere
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# VectorDB: chroma | qdrant | pgvector
VECTORDB_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=documents
QDRANT_URL=http://localhost:6333

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.7

# Monitoring
LANGSMITH_API_KEY=
ENABLE_TRACING=false

# Security
ENABLE_GUARDRAILS=true
MAX_REQUEST_SIZE_MB=10

# Evaluation
ENABLE_EVAL=false
