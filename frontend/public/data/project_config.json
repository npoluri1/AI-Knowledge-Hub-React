  "AI_Agent_Marketplace": {
    "name": "AI Agent Marketplace",
    "dir": "AI_Agent_Marketplace",
    "icon": "shopping_cart",
    "color": "#8b5cf6",
    "endpoints": {
      "agents": "/api/v1/marketplace/agents",
      "categories": "/api/v1/marketplace/categories",
      "discover": "/api/v1/marketplace/discover"
    },
    "domain_kpis": [
      {
        "label": "Agents Listed",
        "endpoint": "agents",
        "field": "total",
        "color": "violet"
      },
      {
        "label": "Categories",
        "endpoint": "categories",
        "field": "length",
        "color": "blue"
      },
      {
        "label": "Active Publishers",
        "endpoint": "discover",
        "field": "publishers",
        "color": "green"
      }
    ],
    "tables": [
      {
        "title": "Featured Agents",
        "endpoint": "/api/v1/marketplace/agents",
        "params": {
          "limit": 10
        },
        "columns": [
          "id",
          "name",
          "publisher",
          "category",
          "rating",
          "price"
        ]
      }
    ],
    "features": [
      "Publish",
      "Discover",
      "Billing",
      "Guardrails",
      "RAG Engine"
    ]
  },
