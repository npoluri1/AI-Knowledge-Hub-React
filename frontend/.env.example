# Copy this file to frontend/.env and add your own key.
# Free model inference still requires an OpenRouter API key.
OPENROUTER_API_KEY=replace_with_your_openrouter_key

# The official free router is the default. These explicit free IDs are fallback routes.
OPENROUTER_FREE_MODELS=openrouter/free,qwen/qwen3-4b:free,google/gemma-3-27b-it:free,meta-llama/llama-3.3-70b-instruct:free

# Optional overrides. Leave unset to use the free router above.
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_VISION_MODEL=openrouter/free
